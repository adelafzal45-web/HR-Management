{
 "compilerOptions": {
 "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
 "target": "es2023",
 "lib": ["ES2023", "DOM"],
 "module": "esnext",
 "types": ["vite/client"],
 "allowArbitraryExtensions": true,
 "skipLibCheck": true,

 /* Bundler mode */
 "moduleResolution": "bundler",
 "paths": {
 "@/*": ["./src/*"]
 },
 "allowImportingTsExtensions": true,
 "verbatimModuleSyntax": true,
 "moduleDetection": "force",
 "noEmit": true,
 "jsx": "react-jsx",

 /* Linting */
 "noImplicitAny": true,
 "noUnusedLocals": true,
 "noUnusedParameters": true,
 "erasableSyntaxOnly": true,
 "noFallthroughCasesInSwitch": true
 },
 "include": ["src"],
 "exclude": [
  "src/app.controller.ts",
  "src/app.controller.spec.ts",
  "src/app.module.ts",
  "src/app.service.ts",
  "src/data-source.ts",
  "src/main.ts",
  "src/apprisal-question-options",
  "src/attendance",
  "src/auth",
  "src/permissions",
  "src/users"
 ]
}
