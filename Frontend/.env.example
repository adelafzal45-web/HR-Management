# Base URL of the NestJS backend, including its global `/api` prefix. The app
# pings {VITE_API_BASE_URL} itself (the Swagger doc's root "App" route) to
# detect whether the backend is attached, and falls back to demo data
# per-screen if not.
#
# IMPORTANT: Vite inlines this at BUILD time, not runtime. Whatever is set when
# `npm run build` runs is baked into the bundle and cannot be changed by
# editing a file on the server afterwards — you have to rebuild. Set it in the
# deploy environment (or in `.env.production`) BEFORE building.
#
# Leave it unset and the app falls back to `<the origin it is served
# from>/api`, which is correct when a reverse proxy puts the frontend and the
# backend behind one hostname. Set it explicitly when the API lives on a
# different host, e.g.
#
#   VITE_API_BASE_URL=https://api.example.com/api
#
# The line below is the local-development value.
VITE_API_BASE_URL=http://localhost:3000/api
